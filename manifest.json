{
  "schema": 1,
  "id": "valet-agent",
  "name": "Agent",
  "version": "0.1.0",
  "description": "Run queue, provider bridging, fallbacks, slash commands and the model catalog.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["settings@2"],
  "requires": ["inference@1", "context@1"],
  "optionalRequires": ["tools@1"],
  "settings": {
    "sections": {
      "system": {
        "icon": "bot",
        "order": 0,
        "subsections": [
          {
            "id": "chat",
            "label": "Chat",
            "items": [
              {
                "id": "queueMode",
                "label": "When you send during a turn",
                "summary": "Queue waits for the running turn. Interrupt stops it and answers the new message.",
                "input": {
                  "type": "select",
                  "style": "segmented",
                  "options": [
                    {
                      "value": "queue",
                      "label": "Queue"
                    },
                    {
                      "value": "interrupt",
                      "label": "Interrupt"
                    }
                  ],
                  "default": "queue"
                }
              },
              {
                "id": "subagentWakeGroupSeconds",
                "label": "Group subagent wake-ups",
                "summary": "When a background subagent ends, wait this long (seconds) for more to end and wake the chat once for all of them. Each one that ends in the meantime adds this long again. The chat is woken at once when none are left running. 0 wakes for every subagent on its own.",
                "input": {
                  "type": "number",
                  "min": 0,
                  "unit": "s",
                  "default": 15
                }
              }
            ]
          },
          {
            "id": "tools",
            "label": "Tools",
            "items": [
              {
                "id": "presentConfine",
                "label": "Confine present to the workspace",
                "summary": "The present tool shares files only from the project workspace and the folders below. Off lets it share any path valet can read, and limits it to owner runs.",
                "input": {
                  "type": "bool",
                  "default": true
                }
              },
              {
                "id": "presentRoots",
                "label": "Extra present folders",
                "summary": "Absolute folders present may also read from while it is confined.",
                "when": {
                  "eq": ["presentConfine", true]
                },
                "input": {
                  "type": "list",
                  "item": {
                    "type": "path",
                    "kind": "dir"
                  },
                  "addLabel": "Add folder",
                  "default": []
                }
              },
              {
                "id": "exposedTools",
                "label": "Tools for agent harnesses",
                "summary": "Tool names harnesses like Claude Code and Devin may see. Unset offers every tool the run's role allows.",
                "advanced": true,
                "input": {
                  "type": "multiselect",
                  "style": "chips",
                  "options": {
                    "from": "tools"
                  }
                }
              }
            ]
          }
        ]
      },
      "inference": {
        "icon": "sparkles",
        "order": 900,
        "subsections": [
          {
            "id": "models",
            "label": "Models",
            "summary": "Every model your providers offer, plus the ones you add. Turn models off to keep them out of the picker, or rename them and fix their limits.",
            "items": [
              {
                "id": "defaultModel",
                "label": "Default model",
                "summary": "For sessions and projects that don't pick one.",
                "input": {
                  "type": "group",
                  "inputs": [
                    {
                      "id": "provider",
                      "type": "ref",
                      "label": "Provider",
                      "options": {
                        "from": "providers"
                      },
                      "required": true
                    },
                    {
                      "id": "model",
                      "type": "ref",
                      "label": "Model",
                      "options": {
                        "from": "models",
                        "args": {
                          "provider": {
                            "$": "defaultModel.provider"
                          }
                        }
                      },
                      "required": true
                    },
                    {
                      "id": "effort",
                      "type": "select",
                      "label": "Effort",
                      "options": {
                        "from": "efforts",
                        "args": {
                          "provider": {
                            "$": "defaultModel.provider"
                          },
                          "model": {
                            "$": "defaultModel.model"
                          }
                        }
                      }
                    },
                    {
                      "id": "fast",
                      "type": "bool",
                      "label": "Fast mode"
                    },
                    {
                      "id": "fallbacks",
                      "type": "list",
                      "label": "Fallbacks",
                      "addLabel": "Add fallback",
                      "item": {
                        "type": "group",
                        "layout": "row",
                        "inputs": [
                          {
                            "id": "provider",
                            "type": "ref",
                            "label": "Provider",
                            "options": {
                              "from": "providers"
                            },
                            "required": true
                          },
                          {
                            "id": "model",
                            "type": "ref",
                            "label": "Model",
                            "options": {
                              "from": "models",
                              "args": {
                                "provider": {
                                  "$": "@.provider"
                                }
                              }
                            },
                            "required": true
                          },
                          {
                            "id": "effort",
                            "type": "select",
                            "label": "Effort",
                            "options": {
                              "from": "efforts",
                              "args": {
                                "provider": {
                                  "$": "@.provider"
                                },
                                "model": {
                                  "$": "@.model"
                                }
                              }
                            }
                          },
                          {
                            "id": "fast",
                            "type": "bool",
                            "label": "Fast mode"
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "id": "models",
                "label": "Model list",
                "summary": "Overrides and models added by hand, by provider.",
                "input": {
                  "type": "list",
                  "style": "table",
                  "default": [],
                  "item": {
                    "type": "group",
                    "inputs": [
                      {
                        "id": "provider",
                        "type": "ref",
                        "label": "Provider",
                        "options": {
                          "from": "providers"
                        },
                        "required": true
                      },
                      {
                        "id": "id",
                        "type": "string",
                        "label": "Model id",
                        "minLength": 1,
                        "required": true
                      },
                      {
                        "id": "show",
                        "type": "bool",
                        "label": "In the picker"
                      },
                      {
                        "id": "name",
                        "type": "string",
                        "label": "Name"
                      },
                      {
                        "id": "contextWindow",
                        "type": "tokens",
                        "label": "Context window",
                        "min": 1
                      },
                      {
                        "id": "maxOutputTokens",
                        "type": "tokens",
                        "label": "Max output",
                        "min": 1
                      },
                      {
                        "id": "efforts",
                        "type": "tags",
                        "label": "Efforts"
                      },
                      {
                        "id": "defaultEffort",
                        "type": "string",
                        "label": "Default effort"
                      },
                      {
                        "id": "fast",
                        "type": "bool",
                        "label": "Fast mode"
                      },
                      {
                        "id": "custom",
                        "type": "bool",
                        "label": "Added by hand"
                      }
                    ]
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
